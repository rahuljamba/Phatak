# ==============================================================================
# Phatak Punjab - Environment Configuration Example
# ==============================================================================

# Application Environment Mode ('dev' for local testing with dev_otp, 'prod' for strict production)
ENV_MODE=dev

# Port for Uvicorn
PORT=8000

# Secret Key for Signing HMAC-SHA256 Session Bearer Tokens (change in production)
AUTH_SECRET_KEY=phatak-punjab-auth-secret-key-32chars-minimum-prod

# SQLite Database Storage Path (default: phatak.db in repo root)
# PHATAK_DB_PATH=phatak.db

# ==============================================================================
# Google Firebase Phone Authentication (10,000 Free SMS / Month)
# Get these values from: Firebase Console -> Project Settings -> General -> Your Apps (Web)
# ==============================================================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
